# eos environment variables
# Copy to .env for local dev, and set the same keys in Vercel (Settings → Environment Variables).

# Optional: override the API base URL. Defaults to the deployed Worker
# (https://smartrun-api.eos-run.workers.dev) in production, same origin in dev.
# VITE_API_URL=

# ─── Worker secrets (set via Cloudflare, NOT here) ─────────────
# These are configured on the Worker, not in Vercel:
#   DEEPSEEK_API_KEY — DeepSeek chat API key for the AI Coach
#                      (https://platform.deepseek.com)
#   AMAP_KEY         — 高德地图 Web服务 key for address search + route
#                      (https://console.amap.com/dev/key/app)
# Set them with:  echo "xxx" | npx wrangler secret put <NAME>
